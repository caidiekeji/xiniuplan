# ============================================
# frontend/.dockerignore - 前端构建上下文
# ============================================

# ===== 依赖和构建产物 =====
node_modules/
dist/
.vite/

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 日志 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.swp
*.swo
*.iml

# ===== 环境变量 =====
.env
.env.local
.env.*.local

# ===== 临时文件 =====
*.tmp
*.bak
