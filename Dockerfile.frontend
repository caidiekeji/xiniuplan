# ============================================
# 云枢面板 - 前端 Dockerfile（多阶段：Node 构建 + Nginx 运行）
# 构建上下文：项目根目录
# 构建命令：docker build -f Dockerfile.frontend -t cloudpivot-frontend .
# ============================================

# ---------- 构建阶段 ----------
FROM node:22-alpine AS builder

WORKDIR /app

# 先复制依赖清单，利用 Docker 层缓存加速构建
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# 复制前端源码并构建
COPY frontend/ .
RUN npm run build

# ---------- 运行阶段 ----------
FROM nginx:alpine

# Nginx 配置（SPA 回退 + API 反向代理）
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# 构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
