# ============================================
# 云枢面板 - 后端 Dockerfile
# 构建上下文：项目根目录
# 构建命令：docker build -f Dockerfile.backend -t cloudpivot-backend .
# ============================================

# ---------- 构建阶段 ----------
FROM golang:1.25-alpine AS builder

WORKDIR /build

# 安装 git（go mod 下载私有依赖时需要）
RUN apk add --no-cache git

# 先复制依赖文件，利用 Docker 层缓存加速构建
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# 复制后端全部源码
COPY backend/ .

# 编译为静态链接二进制（CGO_ENABLED=0），去除调试信息减小体积
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o cloudpivot ./cmd/agent/

# ---------- 运行阶段 ----------
FROM alpine:3.20

# 安装运行时依赖：
#   ca-certificates - HTTPS 请求所需根证书
#   tzdata          - 时区数据支持
RUN apk add --no-cache ca-certificates tzdata

# 创建非 root 用户和用户组
RUN addgroup -S cloudpivot && \
    adduser -S cloudpivot -G cloudpivot

# 创建应用所需目录
#   data    - SQLite 数据库、JWT 密钥
#   store   - 应用定义文件
#   runtime - 运行时临时文件
#   www     - 网站文件根目录
RUN mkdir -p /opt/cloudpivot/data \
             /opt/cloudpivot/store \
             /opt/cloudpivot/runtime \
             /www

# 从构建阶段复制编译好的二进制文件
COPY --from=builder /build/cloudpivot /usr/local/bin/cloudpivot

# 复制配置文件（构建上下文为项目根目录，路径需加 backend/ 前缀）
COPY backend/config.yaml /opt/cloudpivot/config.yaml

# 复制应用定义（store/apps 位于项目根目录下）
COPY store/apps /opt/cloudpivot/store/apps

# 设置工作目录（config.yaml 中的相对路径基于此目录解析）
WORKDIR /opt/cloudpivot

# 切换到非 root 用户运行
USER cloudpivot

# 暴露服务端口
EXPOSE 8888

# 健康检查：每 30 秒检测一次 /health 端点
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8888/health || exit 1

# 启动入口
ENTRYPOINT ["cloudpivot"]
